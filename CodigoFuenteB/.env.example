# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.

# Secreto para firmar los JWT (obligatorio, mínimo 32 caracteres).
# Genérelo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Base de datos (usada por docker-compose para construir DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=cuidarteplus

# Puertos expuestos
PORT_POSTGRES=15442
PORT_BACKEND=4444
PORT_FRONTEND=3333
